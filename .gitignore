# QQM-BetterDownload
# The root is an allowlist: only source, documentation and build inputs are
# tracked. scripts/check-repo.ps1 audits the result and these ignore rules.

# ---- Root allowlist -------------------------------------------------------
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CHANGELOG.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/src/
!/native/
!/setup/
!/tests/
!/scripts/
!/docs/
!/promo/
!/licenses/

# ---- Build output, toolchains and downloads (any depth) -------------------
# build/ also holds restored NuGet packages (build/deps) and test runs.
.tools/
build/
dist/
bin/
obj/
out/
node_modules/
package-lock.json

# ---- Local notes, research and editor state -------------------------------
.research/
.planning/
.claude/
.codex/
.vs/
.vscode/
.idea/
.venv/
__pycache__/
tmp/
temp/
task_plan.md
findings.md
progress.md
AGENTS.md
CLAUDE.md

# ---- Binaries, archives and temporary files -------------------------------
*.exe
*.dll
*.pdb
*.obj
*.o
*.lib
*.a
*.ilk
*.exp
*.zip
*.7z
*.rar
*.nupkg
*.pyc
*.log
*.dmp
*.tmp
*.temp
*.part
*.bak
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# ---- Runtime data: never commit user state, keys or client databases ------
# Files BetterDownload writes to %LOCALAPPDATA%\QQM-BetterDownload.
settings.json
receipts.json
installation.json
detected-paths.json
agent-status.json
worker-status.json
worker-error.json
setup-error.json
shortcut-owned.txt
native-ui/
events/
test-runs/
# QQ Music's key store (MMKV), databases and credentials.
mmkv*
*.cah
*.crc
*.dat
*.db
*.sqlite
*.sqlite3
*.evt
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# ---- Music and client cache: no user audio, even inside source folders ----
VipSongsDownload/
QQMusicCache/
unlock/
*.ncm
*.mflac*
*.mgg*
*.mmp4
*.qmc*
*.flac
*.mp3
*.ogg
*.wav
*.m4a
*.lrc
*.qrc

# ---- Required exceptions --------------------------------------------------
# The documented, original one-second test tone.
!/tests/fixtures/tone.flac
# Upstream license text; "mmkv*" matches it on case-insensitive file systems.
!/licenses/MMKV.txt
