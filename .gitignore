# Root allowlist: source, documentation and build inputs only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/src/
!/native/
!/setup/
!/scripts/
!/tests/
!/docs/
!/promo/
!/licenses/
!/.github/
!/预览卡片.cmd

# Local research, plans, toolchains, builds and working data (at any depth).
.research/
.tools/
.planning/
.codex/
.claude/
.vs/
.vscode/
.idea/
.venv/
__pycache__/
node_modules/
build/
dist/
bin/
obj/
out/
tmp/
temp/
output/
test-runs/
native-ui/
task_plan.md
findings.md
progress.md
AGENTS.md
CLAUDE.md

# Earlier proxy-DLL experiment; the shipping source uses bridge.c.
/native/loader.c
/native/msimg32.def

# Binaries, downloaded packages, crash dumps and temporary files.
*.exe
*.dll
*.pdb
*.obj
*.o
*.lib
*.a
*.ilk
*.exp
*.zip
*.7z
*.rar
*.nupkg
*.pyc
*.log
*.dmp
*.tmp
*.temp
*.part
*.bak
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# Credentials, client databases, machine-specific settings and event receipts.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.cah
*.crc
*.dat
*.db
*.sqlite
*.sqlite3
*.evt
mmkv*
settings.json
receipts.json
agent-status.json
detected-paths.json
worker-error.json
worker-status.json
setup-error.json
installation.json
shortcut-owned.txt

# No user music or client cache, even if placed in a source directory.
VipSongsDownload/
QQMusicCache/
unlock/
*.ncm
*.mflac*
*.mgg*
*.mmp4
*.qmc*
*.flac
*.mp3
*.ogg
*.wav
*.m4a
*.lrc
*.qrc

# One documented, original one-second tone is a required test fixture.
!/tests/fixtures/tone.flac
!/licenses/MMKV.txt
